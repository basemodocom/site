---
import Base from "../layouts/Base.astro";
---

<Base title="About" description="Who we are and what we do.">
  <article class="space-y-6">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <p class="text-lg text-muted">
      A short introduction: who is behind this site and what it is for.
    </p>
    <div class="space-y-4 leading-relaxed">
      <p>
        Use this page for the longer story. Explain what you do, who it is for and how people
        can reach you. Keep paragraphs short; most visitors skim.
      </p>
      <h2 class="pt-4 text-xl font-semibold tracking-tight">Get in touch</h2>
      <p>
        Write to
        <a href="mailto:hello@example.com" class="text-accent underline underline-offset-4"
          >hello@example.com</a
        >.
      </p>
    </div>
  </article>
</Base>
