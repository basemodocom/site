---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-line">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="font-semibold tracking-tight">{siteName}</a>
    <ul class="flex gap-6 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? "page" : undefined}
              class="text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
